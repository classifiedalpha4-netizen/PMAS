# Ensure PHP files are always saved without BOM and with LF line endings
*.php text eol=lf
*.css text eol=lf
*.js  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
